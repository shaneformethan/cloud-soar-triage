# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and will NOT be committed.

# --- Threat-intelligence API keys (free tiers work) ---
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=your_otx_key_here

# --- Local paths / runtime ---
# Folder holding the raw CSE-CIC-IDS2018 CSVs (download separately)
CIC_IDS2018_DIR=./data/raw/cic-ids2018
# Compute device: cpu or cuda
DEVICE=cpu
# Data mode: real or dummy (dummy = no API/dataset needed, for smoke tests)
DATA_MODE=real
